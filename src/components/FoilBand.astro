---
/*
 * A band of holofoil across the foot of the page, cut as the vintage Carddass
 * prism: a square checkerboard where every cell is spun about its own middle,
 * so the spectrum converges on that point and neighbours answer the light in
 * opposite hands.
 *
 * Nothing animates on its own. All of the movement comes from the viewing
 * angle, which is the whole point of foil. That angle is a slow ping-pong, or
 * where the viewer's head actually is once they turn the camera on.
 */

interface Props {
	note: string;
}

const { note } = Astro.props;
---

{/*
  The foil is the page's own backdrop: one sheet behind everything, with the
  solid colour laid over it and the band at the foot simply where that colour
  stops.
*/}
<canvas class="foil__gl" aria-hidden="true"></canvas>

<footer class="foot">
	<div class="foot__row">
		<span class="foot__note" data-scramble="540">{note}</span>

		{/* Glyphs from Lucide 1.31.0 (camera-off, camera), ISC. https://lucide.dev/license */}
		<button
			class="foot__tilt"
			type="button"
			data-tilt
			aria-pressed="false"
			aria-label="Tilt with camera"
			title="Tilt with camera"
		>
			<svg
				class="foot__icon foot__icon--off"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M14.564 14.558a3 3 0 1 1-4.122-4.121"></path>
				<path d="m2 2 20 20"></path>
				<path d="M20 20H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 .819-.175"></path>
				<path
					d="M9.695 4.024A2 2 0 0 1 10.004 4h3.993a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v7.344"
				></path>
			</svg>

			<svg
				class="foot__icon foot__icon--on"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path
					d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"
				></path>
				<circle cx="12" cy="13" r="3"></circle>
			</svg>
		</button>
	</div>
</footer>

<style>
	/*
	 * The whole page, not a strip at the foot of it.
	 *
	 * The large viewport rather than the page's own height, which is the small
	 * one. The difference is the strip a phone's address bar sits over, and it
	 * appears the moment that bar retracts. The page has no business growing
	 * into it, or the footer would move about as the bar came and went, but the
	 * foil behind the footer very much does: it is what the visitor sees at the
	 * bottom of the screen, so it has to reach the bottom of the screen.
	 *
	 * Both dimensions are stated outright. Inset alone will not do it: a canvas
	 * is a replaced element, so with an auto height it takes its own buffer's
	 * aspect ratio and quietly ignores the bottom edge, which leaves it covering
	 * half the page and the flat fallback colour showing under the rest.
	 */
	.foil__gl {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100lvh;
	}

	/*
	 * The last block in the column, so it sits at the bottom of the screen
	 * without being pinned there: the stage above takes the slack.
	 */
	.foot {
		position: relative;
		flex: none;
		height: clamp(3rem, 7.5svh, 5rem);
		display: flex;
		align-items: center;
		padding: 0 clamp(0.9rem, 2.4vw, 1.6rem);
		font-size: clamp(0.6rem, 1.5vw, 0.7rem);
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.foot__row {
		position: relative;
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: 1.5em;
	}

	/*
	 * Knocked out of a black slug rather than set on it. Multiply keeps black
	 * opaque and lets white through untouched, so the letterforms and the icon
	 * strokes are holes, and the foil moving behind them is the mark.
	 */
	.foot__note,
	.foot__tilt {
		background: var(--ink);
		color: #fff;
		border-radius: 3px;
		mix-blend-mode: multiply;
	}

	.foot__note {
		padding: 0.5em 0.7em;
		/* Knockout type needs the weight: thin strokes leave too little of the
		   foil showing to read as anything. */
		font-weight: 700;
		opacity: 0;
		animation: foil-fade 0.25s linear 0.64s forwards;
	}

	/* Same box as the links in the top corner. */
	.foot__tilt {
		display: grid;
		place-items: center;
		width: var(--icon-box);
		height: var(--icon-box);
		padding: 0;
		border: 0;
		cursor: pointer;
		opacity: 0;
		animation: foil-fade 0.25s linear 0.7s forwards;
	}

	.foot__icon {
		grid-area: 1 / 1;
		display: block;
		width: var(--icon-glyph);
		height: auto;
	}

	/*
	 * No camera on a touch device: the handset reports its own tilt, which is
	 * both truer and free. The button is only there for pointer machines, which
	 * have no idea how they are being held.
	 */
	@media (hover: none) and (pointer: coarse) {
		.foot__tilt {
			display: none;
		}
	}

	/* The glyph reports the state: struck through while the camera is off. */
	.foot__tilt[aria-pressed='false'] .foot__icon--on,
	.foot__tilt[aria-pressed='true'] .foot__icon--off {
		display: none;
	}

	/* Hover drops the knockout, so the glyph goes solid instead of showing the
	   foil through it. */
	.foot__tilt:hover,
	.foot__tilt:focus-visible {
		color: var(--acid);
		mix-blend-mode: normal;
		outline: none;
	}

	@keyframes foil-fade {
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.foot__note,
		.foot__tilt {
			opacity: 1;
		}
	}
</style>

<script>
	import { acid, driftAcid } from '../scripts/acid';

	/* Shader ----------------------------------------------------------- */

	const VERT = `
		attribute vec2 a_pos;
		varying vec2 v_uv;
		void main() {
			v_uv = vec2(a_pos.x, -a_pos.y) * 0.5 + 0.5;
			gl_Position = vec4(a_pos, 0.0, 1.0);
		}
	`;

	const FRAG = `
		precision highp float;

		varying vec2 v_uv;

		uniform vec2 u_res;    // canvas size in CSS pixels
		uniform vec2 u_tilt;   // view angle, roughly -1..1 on each axis
		uniform vec3 u_acid;
		// Turns of the spectrum per turn around a cell's centre. Whole numbers
		// only: anything else tears the hue along the seam at half a turn.
		const float TURNS = 3.0;

		// Scales CELL_DRIFT below. Zero makes every cell of a parity identical.
		const float DRIFT = 0.5;

		// How far the spectrum is allowed from white. At zero the foil is bare
		// silver working only in light and shade; at one it is a full rainbow.
		// Prism foil sits nearer the silver end: a mirror with a rainbow in it.
		const float SATURATION = 0.5;

		/*
		 * How much of a revolution carries colour at all.
		 *
		 * On a disc the spectrum does not run evenly all the way round: it crowds
		 * into an arc facing the light, and the rest of the turn is plain silver.
		 * This is the exponent on that falloff, so a low number spreads colour
		 * around the whole cell and a high one squeezes it into a narrow wedge with
		 * grey either side. It is a different thing from saturation, which sets how
		 * strong the colour is once it is there rather than how far it reaches.
		 */
		const float ARC = 1.5;

		const float TAU = 6.28318530718;

		// A cell across, in CSS pixels rather than a fraction of the canvas, so the
		// grain keeps its size instead of stretching with the viewport.
		const float CELL = 30.0;


		// How tight the sheen runs, and how far the colour is allowed from white.
		// Prism foil is a mirror with a rainbow in it, not a rainbow.
		const float SHARPNESS = 3.5;

		// The eye, in CSS pixels: how far in front of the page it sits, and how
		// far it travels from one side of the window to the other. Their ratio is
		// the whole swing of the viewing angle, so it decides how much of the
		// spectrum a visitor can turn up by crossing the page.
		const float EYE_DIST = 700.0;
		const float EYE_TRAVEL = 700.0;

		/*
		 * How far the tilt turns the sweep directly, on top of the geometry.
		 *
		 * The geometry alone will not do it. The in-plane part of a view direction
		 * can never be longer than one, and the light does not move, so the anchor
		 * the two define together swings only about a hundred degrees end to end,
		 * and spends most of that near the middle of its travel: four times faster
		 * there than at the ends, which reads as a pattern that sits still and then
		 * lurches. Turning it with the tilt as well spends most of the spectrum
		 * over the range and levels the rate out.
		 */
		const float TILT_TURN = 2.36;  // 0.75 of a half turn

		// Spokes of tooling around a cell. Kept low: at any real density they
		// alias into moire long before they read as grooves.
		const float RULING_SPOKES = 14.0;

		/*
		 * How far a cell's phase drifts per step across the sheet, in turns of the
		 * spectrum, before DRIFT scales it. Real foil is not struck perfectly:
		 * the far corner of a sheet meets the eye at a slightly different angle
		 * from the near one, and the stamping itself wanders. Without this every
		 * cell of a parity is a carbon copy of every other, which is the one thing
		 * that reads as printed rather than as foil.
		 *
		 * The two are detuned, so rows and columns do not come back into step with
		 * each other.
		 */
		const vec2 CELL_DRIFT = vec2(0.013, 0.019);

		// Turns of the spectrum walked per turn of the offset. At zero the pattern
		// only rotates; at one the colours make a full circuit over a full turn of
		// the view, which is roughly what the reference discs do.
		// How far the offset walks the whole slice through the spectrum.
		const float HUE_TURNS = 2.5;

		// How wide a slice of the spectrum one cell covers, in turns of the wheel.
		const float SPAN = 0.4;

		// Where that slice sits when the offset is nowhere.
		const float HUE_CENTRE = 0.55;

		// How steeply each cell is embossed, as in-plane slope from its middle to
		// its edge. Parallax alone cannot put a spectrum inside a cell this small:
		// across nineteen pixels at arm's length the angle barely moves. On a real
		// card the sweep comes from the cell being a struck dome rather than a flat
		// patch, so the normal turns across it far faster than the eye does.
		const float EMBOSS = 0.5;

		vec3 spectrum(float t) {
			return 0.5 + 0.5 * cos(TAU * (t + vec3(0.0, 0.33, 0.67)));
		}

		void main() {
			/*
			 * One viewing direction for the whole band, whether it comes from the
			 * pointer or from the camera, so every tile answers the same way and
			 * the sheet reads as one piece of foil rather than as a grid of
			 * tiles each caught at its own angle.
			 *
			 * The variation inside a tile does not come from here. It comes from
			 * the tile itself: the spun grooves and the struck dome, both of which
			 * turn the surface far faster across a few pixels than any parallax
			 * could.
			 */
			vec3 toEye = normalize(vec3(u_tilt * EYE_TRAVEL, EYE_DIST));

			// The light stays where it is while the viewer moves. That asymmetry is
			// what keeps the pattern alive as the angle passes through square.
			vec3 toLight = normalize(vec3(-0.28, -0.72, 1.0));

			// A square checkerboard, square to the page.
			vec2 q = v_uv * u_res / CELL;
			vec2 id = floor(q);
			vec2 f = fract(q) - 0.5;
			float checker = mod(id.x + id.y, 2.0);

			/*
			 * Each square is spun rather than ruled straight: the tooling turns
			 * about the cell's middle, so the grooves are spokes and the colour
			 * runs with the angle around that middle, every hue converging on the
			 * one point. Concentric rings cannot do this. They give two opposed
			 * lobes and no convergence, because the angle only ever enters as its
			 * cosine.
			 */
			vec2 fromCentre = f + vec2(1e-5);
			float theta = atan(fromCentre.y, fromCentre.x);

			// The pattern is anchored to the light-to-eye path, so moving your head
			// spins the whole sweep about the centre rather than sliding it.
			vec2 sweep = toEye.xy + toLight.xy;

			// Seen straight on, that path has no in-plane direction at all, and the
			// anchor is free to snap anywhere: the whole band whips round for a
			// frame. Near that point, hand the direction back to the light, which
			// always has one.
			sweep = mix(toLight.xy, sweep, smoothstep(0.0, 0.35, length(sweep)));
			float azimuth = atan(sweep.y, sweep.x) + u_tilt.x * TILT_TURN;

			/*
			 * Everything below is measured in a frame the view turns, so the cell
			 * is one fixed picture that rotates rather than a picture whose colours
			 * move through it.
			 *
			 * Three things used to break that. The mirrored half of the
			 * checkerboard was written as spin * theta - azimuth, which turns it
			 * the opposite way from its neighbour: the two parities counter-rotated
			 * and read as churn rather than as a turn. The sheen was taken against
			 * the eye, so brightness swam about independently. And the grain was
			 * pinned to the page while the rest of the cell turned under it.
			 */
			/*
			 * One offset, counted in turns, gathering every source: the viewing
			 * angle, wherever it came from, and where this cell sits on the sheet.
			 *
			 * It drives the rotation and the hue together, because on a real disc
			 * those are not separate. Turning it does not merely spin the pattern
			 * about like a wheel, it walks the colours through it at the same time.
			 * Driving only the rotation makes the cell read as a printed picture on
			 * a turntable; driving only the hue leaves it flashing on the spot.
			 */
			/*
			 * The drift is counted from the middle of the sheet outwards, not from
			 * the corner.
			 *
			 * Cell indices all start positive at the top left, so measuring from
			 * there means turning the dial up does not only open out the difference
			 * between neighbours, it drags the average along with it and the whole
			 * band shifts. Measured from the centre, the middle of the sheet holds
			 * still whatever the dial says and the control does only the one thing:
			 * how much the offset changes as you move across in x and y.
			 */
			vec2 middle = floor(0.5 * u_res / CELL);
			float offset = azimuth / TAU + dot(id - middle, CELL_DRIFT) * DRIFT;

			float local = theta - offset * TAU;

			/*
			 * Spun one way here and the other way next door, mirrored inside the
			 * turning frame so both parities still turn together.
			 *
			 * The handedness is the whole of the difference now. Neighbours used to
			 * be put half a turn of the spectrum apart as well, which is what made
			 * every other square jump to an opposing colour: a checkerboard you read
			 * as two alternating materials rather than as one sheet struck two ways.
			 * The mirroring alone still tells the cells apart, and the drift across
			 * the sheet still keeps any two from being identical, without the jump.
			 */
			float spin = checker < 0.5 ? 1.0 : -1.0;
			float sweepPhase = spin * local / TAU * TURNS;

			/*
			 * A cell shows a slice of the spectrum, not the whole wheel.
			 *
			 * Running the full wheel round a cell puts complementary colours on
			 * opposite sides of it, which is why this read blue on one side and red
			 * on the other with grey between. The reference does not do that: its
			 * two sides are neighbours in hue. So the sweep oscillates inside a band
			 * rather than cycling through one, and the offset carries the whole band
			 * along the spectrum, which is the colour shift that comes with the
			 * turn.
			 */
			float phase = HUE_CENTRE + offset * HUE_TURNS + SPAN * cos(TAU * sweepPhase);

			// Spun metal is bright where the grooves lie across the light and dark
			// where they run along it: two lobes, opposite one another.
			float thrown = abs(cos(local));

			// Colour only where the cell is throwing it, so the rest stays silver.
			float lit = pow(thrown, ARC);
			vec3 hue = mix(vec3(1.0), spectrum(phase), SATURATION * lit);

			// The dome, struck the opposite way next door so the sheen breaks at
			// the seam. Turned with the frame and lit head-on, so the highlight
			// rides round with the pattern instead of sliding across it.
			float ca = cos(-azimuth);
			float sa = sin(-azimuth);
			vec2 turned = vec2(
				ca * fromCentre.x - sa * fromCentre.y,
				sa * fromCentre.x + ca * fromCentre.y
			);
			vec3 normal = normalize(vec3(-turned * EMBOSS * spin, 1.0));
			vec3 mirror = reflect(-toLight, normal);
			float sheen = pow(max(mirror.z, 0.0), SHARPNESS);

			// The grooves themselves, as grain. Faded out near the middle, where
			// spokes this fine would only alias.
			float ruling = sin(local * RULING_SPOKES);
			float glint = smoothstep(0.55, 1.0, ruling)
				* smoothstep(0.0, 0.22, length(fromCentre)) * 0.03;

			// Foil is scored between the cells, so the seams catch first. Faint:
			// any stronger and the grid reads as drawn rather than as tooling.
			glint += smoothstep(0.44, 0.5, max(abs(f.x), abs(f.y))) * 0.07;

			// A touch of the page colour so the band belongs to it, but only a
			// touch: this finish is closer to a CD than to a prism.
			vec3 tint = mix(u_acid, vec3(1.0), 0.18);
			vec3 foil = hue * (0.58 + 0.3 * thrown + 0.28 * sheen);
			foil = mix(foil, foil * tint * 1.55, 0.1);
			foil += glint * (0.45 + 0.55 * hue);

			gl_FragColor = vec4(clamp(foil, 0.0, 1.0), 1.0);
		}
	`;

	function compile(gl: WebGLRenderingContext, type: number, src: string) {
		const shader = gl.createShader(type);
		if (!shader) return null;
		gl.shaderSource(shader, src);
		gl.compileShader(shader);
		if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
			console.warn(gl.getShaderInfoLog(shader));
			gl.deleteShader(shader);
			return null;
		}
		return shader;
	}

	/* Head tracking ---------------------------------------------------- */

	/*
	 * Where the viewer's head is, as an offset from centre. Nothing leaves the
	 * page: frames go to a 64x48 scratch canvas and nowhere else, and the camera
	 * is only ever touched after a click.
	 *
	 * FaceDetector does the job properly where it exists, which today is
	 * essentially Chrome with the flag on. The fallback is a skin-tone centroid,
	 * which is crude and hates bad light, but it tracks a head well enough to
	 * drive a reflection and costs nothing to ship.
	 */
	type Head = { x: number; y: number; found: boolean };

	// A front camera hands over an unmirrored frame, so leaning right moves the
	// head left in it. Flip so the reflection follows the way you actually lean.
	const FLIP_X = -1;

	function createTracker() {
		const video = document.createElement('video');
		video.muted = true;
		video.playsInline = true;

		const scratch = document.createElement('canvas');
		scratch.width = 64;
		scratch.height = 48;
		const ctx = scratch.getContext('2d', { willReadFrequently: true });

		const Detector = (window as unknown as { FaceDetector?: new (o: object) => object })
			.FaceDetector;
		const detector = Detector ? new Detector({ fastMode: true, maxDetectedFaces: 1 }) : null;
		let stream: MediaStream | null = null;

		const read = async (): Promise<Head> => {
			if (!ctx || video.readyState < 2) return { x: 0, y: 0, found: false };

			if (detector) {
				const faces = await (
					detector as { detect: (v: HTMLVideoElement) => Promise<{ boundingBox: DOMRectReadOnly }[]> }
				).detect(video);
				const box = faces[0]?.boundingBox;
				if (box) {
					return {
						x: (box.x + box.width / 2) / video.videoWidth - 0.5,
						y: (box.y + box.height / 2) / video.videoHeight - 0.5,
						found: true,
					};
				}
				return { x: 0, y: 0, found: false };
			}

			ctx.drawImage(video, 0, 0, scratch.width, scratch.height);
			const { data } = ctx.getImageData(0, 0, scratch.width, scratch.height);
			let sx = 0;
			let sy = 0;
			let weight = 0;
			for (let i = 0, px = 0; i < data.length; i += 4, px++) {
				const r = data[i];
				const g = data[i + 1];
				const b = data[i + 2];
				const max = Math.max(r, g, b);
				const min = Math.min(r, g, b);
				// The usual skin-tone box: warm, not grey, red ahead of the rest.
				const skin = r > 80 && g > 30 && b > 15 && max - min > 12 && r - g > 12 && r > b;
				if (!skin) continue;
				sx += px % scratch.width;
				sy += (px / scratch.width) | 0;
				weight++;
			}
			// Too few pixels is noise, not a face.
			if (weight < 25) return { x: 0, y: 0, found: false };
			return {
				x: sx / weight / scratch.width - 0.5,
				y: sy / weight / scratch.height - 0.5,
				found: true,
			};
		};

		const start = async () => {
			stream = await navigator.mediaDevices.getUserMedia({
				video: { width: 320, height: 240, facingMode: 'user' },
			});
			video.srcObject = stream;
			await video.play();
		};

		const stop = () => {
			stream?.getTracks().forEach((track) => track.stop());
			stream = null;
			video.srcObject = null;
		};

		return { start, stop, read };
	}

	/* Strip ------------------------------------------------------------ */

	function renderStrip() {
		const canvas = document.querySelector<HTMLCanvasElement>('.foil__gl');
		if (!canvas) return;

		const gl = canvas.getContext('webgl', {
			alpha: false,
			antialias: false,
			depth: false,
			stencil: false,
		});
		if (!gl) return;

		const vs = compile(gl, gl.VERTEX_SHADER, VERT);
		const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
		const program = gl.createProgram();
		if (!vs || !fs || !program) return;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
			console.warn(gl.getProgramInfoLog(program));
			return;
		}
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const loc = gl.getAttribLocation(program, 'a_pos');
		gl.enableVertexAttribArray(loc);
		gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

		const u = {
			res: gl.getUniformLocation(program, 'u_res'),
			tilt: gl.getUniformLocation(program, 'u_tilt'),
			acid: gl.getUniformLocation(program, 'u_acid'),
		};

		const resize = () => {
			const rect = canvas.getBoundingClientRect();
			// Capped lower than the usual 2: this now covers the whole page, and
			// the finish is soft enough that the extra samples buy nothing worth
			// four times the fill rate on a phone.
			const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
			const w = Math.max(1, Math.round(rect.width * dpr));
			const h = Math.max(1, Math.round(rect.height * dpr));
			if (canvas.width === w && canvas.height === h) return;

			canvas.width = w;
			canvas.height = h;
			gl.viewport(0, 0, w, h);
			// CSS pixels, not device pixels: the cell size is a design measure and
			// should not halve on a retina screen.
			gl.uniform2f(u.res, rect.width, rect.height);
		};

		resize();
		new ResizeObserver(resize).observe(document.documentElement);

		/*
		 * Three ways in, in order of preference: the phone's own tilt, the camera,
		 * and failing both a slow ping-pong. The pointer is deliberately not one of
		 * them. The foil is a surface being looked at, not a control, and tying it
		 * to the cursor made it read as a thing you operate.
		 *
		 * On a phone the accelerometer is the real article: the sheet answers to
		 * how the handset is actually held, which is what foil does. Nothing else
		 * runs there. The loop would only fight the hand, and the camera is a great
		 * deal to ask for something the hardware already knows.
		 */
		const WANDER_PERIOD = 24; // seconds for a full there and back
		const WANDER = 0.5;


		/*
		 * A triangle, not a sine. A sine spends most of its time near its ends,
		 * where its speed falls to nothing, and that reads as a pause at each
		 * extreme rather than as a pass. A triangle holds one speed the whole way
		 * across; the follow filter below rounds off the turn, so nothing snaps.
		 */
		const pingPong = (seconds: number, period: number, offset: number) => {
			const u = (seconds / period + offset) % 1;
			return 1 - 4 * Math.abs(u - 0.5);
		};

		const head = { x: 0, y: 0, live: false };
		const held = { x: 0, y: 0, live: false };

		/*
		 * A handset answers to how it is held, and to nothing else. The loop is for
		 * machines that cannot know: it would only fight the hand here, and a sheet
		 * of foil that moves while you hold it still is not a sheet of foil.
		 *
		 * The cost is that iOS reports no motion until someone has touched the
		 * page, so until that first touch the foil simply sits where it is. That is
		 * the honest behaviour: still, because nothing has moved it yet.
		 */
		const handheld = window.matchMedia('(hover: none) and (pointer: coarse)').matches;

		/*
		 * How far the handset has to lean for a full swing. Forty-odd degrees, so
		 * the whole range is reachable from a normal grip without waving it about.
		 * Beta is measured from a screen lying flat, and REST is roughly where a
		 * phone sits when someone is reading it, so that reads as no tilt at all.
		 */
		const LEAN = 40;
		const REST = 50;

		/*
		 * How long to wait for the handset to say something before deciding it
		 * never will. Long enough for a granted sensor to report, short enough that
		 * a page which is never going to move does not sit there looking broken.
		 */
		const MOTION_GRACE = 3;

		function listenToTilt() {
			window.addEventListener(
				'deviceorientation',
				(e) => {
					// Arriving is not the same as carrying anything. With Motion and
					// Orientation Access switched off in Settings, iOS grants the
					// permission and then sends events with nothing in them, so the
					// values are the test, not the grant.
					if (e.gamma === null || e.beta === null) return;
					held.live = true;
					held.x = Math.max(-1, Math.min(1, e.gamma / LEAN));
					// Held well under the horizontal: a large vertical swing cancels
					// the light and steers the anchor into its blind spot.
					held.y = Math.max(-1, Math.min(1, (e.beta - REST) / LEAN)) * 0.4;
				},
				{ passive: true }
			);
		}

		/*
		 * iOS will not report motion until someone has asked for it from inside a
		 * gesture, so the first touch anywhere on the page does the asking. That is
		 * a far smaller thing to put in front of a visitor than the camera, and it
		 * needs no control of its own. Everywhere else it simply starts.
		 */
		const Motion = window.DeviceOrientationEvent as unknown as {
			requestPermission?: () => Promise<PermissionState>;
		};

		if (Motion) {
			if (typeof Motion.requestPermission === 'function') {
				const ask = async () => {
					try {
						if ((await Motion.requestPermission!()) === 'granted') listenToTilt();
					} catch {
						// Declined, or an insecure origin, which iOS treats the same
						// way. Either leaves the loop to carry it.
					}
				};
				window.addEventListener('touchend', ask, { once: true, passive: true });
			} else {
				listenToTilt();
			}
		}

		/*
		 * How quickly the foil catches up, per second. The camera needs it: it is
		 * read about eleven times a second, so it has gaps to carry as well as
		 * noise to lose. The loop barely does, being a sine already, but the same
		 * easing carries the handover when the camera goes on or off.
		 */
		const HEAD_FOLLOW = 9;

		/*
		 * Deliberately slow, and doing a second job. A triangle holds one speed the
		 * whole way across, which is what stops the loop dwelling at its ends the
		 * way a sine does, but it reverses in an instant. Following it this loosely
		 * rounds that corner over about a second and leaves the straight middle
		 * alone: the turn eases, the pass does not slow down.
		 */
		const LOOP_FOLLOW = 2;

		/*
		 * Deliberately slow, and it is doing a second job. A triangle holds one
		 * speed the whole way across, which is what stops the loop dwelling at its
		 * ends the way a sine does, but it reverses in an instant. Following it
		 * this loosely rounds that corner over about a second while leaving the
		 * straight middle alone: the turn eases, the pass does not slow down.
		 */

		const tilt = { x: 0, y: 0 };

		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const started = performance.now();
		let last = started;
		let drawn = false;

		const frame = (now: number) => {
			const dt = Math.min((now - last) / 1000, 0.05);
			last = now;
			const t = (now - started) / 1000;

			/*
			 * The vertical is kept well under the horizontal on both paths. Partly
			 * that is how heads move, but mostly a large vertical swing cancels the
			 * light and steers the anchor into the blind spot where it has no
			 * direction left to point.
			 */
			/*
			 * The loop is the fallback, not the default. A handset gets a moment to
			 * report for itself first, and if nothing comes, the loop starts: no
			 * sensor, permission declined, or the switch in Settings turned off, all
			 * of which look the same from here and all of which want the same
			 * answer. Should the handset speak up later, it takes over for good.
			 */
			const noMotion = !handheld || t > MOTION_GRACE;

			let want = { x: 0, y: 0 };
			if (held.live) want = { x: held.x, y: held.y };
			else if (head.live) want = { x: head.x, y: head.y };
			else if (noMotion) {
				// Detuned, so the two axes do not turn back together.
				want = {
					x: pingPong(t, WANDER_PERIOD, 0.25) * WANDER,
					y: pingPong(t, WANDER_PERIOD * 1.64, 0.6) * WANDER * 0.3,
				};
			}

			const follow = 1 - Math.exp(-dt * (held.live || head.live ? HEAD_FOLLOW : LOOP_FOLLOW));
			tilt.x += (want.x - tilt.x) * follow;
			tilt.y += (want.y - tilt.y) * follow;

			/*
			 * Nothing is driving it and it has arrived, so there is nothing new to
			 * draw. Worth the check on a phone waiting for its first touch: without
			 * it that is a full-page shader redrawing an identical picture sixty
			 * times a second on battery.
			 */
			const settled =
				Math.abs(want.x - tilt.x) < 0.0004 && Math.abs(want.y - tilt.y) < 0.0004;
			if (settled && drawn) {
				requestAnimationFrame(frame);
				return;
			}
			drawn = true;

			gl.uniform2f(u.tilt, tilt.x, tilt.y);
			// The band sits flush against the page, so it tracks the drifting
			// colour rather than one sampled once at startup.
			gl.uniform3fv(u.acid, acid());
			gl.drawArrays(gl.TRIANGLES, 0, 3);

			if (!still || head.live) requestAnimationFrame(frame);
		};

		requestAnimationFrame(frame);

		/* Camera opt-in --------------------------------------------------- */

		const button = document.querySelector<HTMLButtonElement>('[data-tilt]');
		let tracker: ReturnType<typeof createTracker> | null = null;

		// The control is a glyph, so its state has to live in the label rather
		// than in what it says.
		const label = (text: string) => {
			button?.setAttribute('aria-label', text);
			button?.setAttribute('title', text);
		};

		button?.addEventListener('click', async () => {
			if (head.live) {
				tracker?.stop();
				tracker = null;
				head.live = false;
				head.x = 0;
				head.y = 0;
				button.setAttribute('aria-pressed', 'false');
				label('Tilt with camera');
				return;
			}

			label('Asking for the camera');
			tracker = createTracker();
			try {
				await tracker.start();
			} catch (err) {
				tracker = null;
				label(`Camera ${(err as Error).name === 'NotAllowedError' ? 'refused' : 'failed'}`);
				return;
			}

			head.live = true;
			button.setAttribute('aria-pressed', 'true');
			label('Tilting with camera');
			if (still) requestAnimationFrame(frame);

			// Reading every frame is wasted work: a head does not move that fast,
			// and the spring is what makes it look continuous anyway.
			let misses = 0;
			const poll = async () => {
				if (!head.live || !tracker) return;
				const found = await tracker.read();
				if (found.found) {
					misses = 0;
					// Scaled up because a head crosses only a fraction of the frame.
					head.x = Math.max(-1, Math.min(1, found.x * 2.6 * FLIP_X));
					head.y = Math.max(-1, Math.min(1, found.y * 2.6));
					label('Tilting with camera');
				} else if (++misses === 8) {
					label('No head found');
				}
				setTimeout(poll, 90);
			};
			poll();
		});
	}

	driftAcid();
	renderStrip();
</script>
