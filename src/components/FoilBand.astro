---
/*
 * A rule of holofoil across the foot of the page, cut as the vintage Carddass
 * prism: a checkerboard of diamonds where every cell holds the same ruled
 * grating and only its orientation turns from cell to cell.
 *
 * Nothing animates on its own. All of the movement comes from the viewing
 * angle, which is the whole point of foil. Off camera that angle is a slow
 * drift with the pointer layered on. On camera it is where the viewer's head
 * actually is.
 */

interface Props {
	note: string;
}

const { note } = Astro.props;
---

<footer class="foot">
	<canvas class="foil__gl" aria-hidden="true"></canvas>

	<div class="foot__row">
		<span class="foot__note" data-scramble="540">{note}</span>

		{/* Glyphs from Lucide 1.31.0 (camera-off, camera), ISC. https://lucide.dev/license */}
		<button
			class="foot__tilt"
			type="button"
			data-tilt
			aria-pressed="false"
			aria-label="Tilt with camera"
			title="Tilt with camera"
		>
			<svg
				class="foot__icon foot__icon--off"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M14.564 14.558a3 3 0 1 1-4.122-4.121"></path>
				<path d="m2 2 20 20"></path>
				<path d="M20 20H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 .819-.175"></path>
				<path
					d="M9.695 4.024A2 2 0 0 1 10.004 4h3.993a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v7.344"
				></path>
			</svg>

			<svg
				class="foot__icon foot__icon--on"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path
					d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"
				></path>
				<circle cx="12" cy="13" r="3"></circle>
			</svg>
		</button>
	</div>
</footer>

<style>
	.foot {
		position: fixed;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 2;
		height: clamp(3.5rem, 9svh, 6rem);
		display: flex;
		align-items: center;
		font-size: clamp(0.6rem, 1.5vw, 0.7rem);
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.foil__gl {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	.foot__row {
		position: relative;
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
		gap: 1.5em;
		padding-inline: clamp(0.9rem, 2.4vw, 1.6rem);
	}

	/*
	 * Knocked out of a black slug rather than set on it. Multiply keeps black
	 * opaque and lets white through untouched, so the letterforms and the icon
	 * strokes are holes, and the foil moving behind them is the mark.
	 */
	.foot__note,
	.foot__tilt {
		background: var(--ink);
		color: #fff;
		border-radius: 3px;
		mix-blend-mode: multiply;
	}

	.foot__note {
		padding: 0.5em 0.7em;
		/* Knockout type needs the weight: thin strokes leave too little of the
		   foil showing to read as anything. */
		font-weight: 700;
		opacity: 0;
		animation: foil-fade 0.25s linear 0.64s forwards;
	}

	/* Same box as the links in the top corner. */
	.foot__tilt {
		display: grid;
		place-items: center;
		width: var(--icon-box);
		height: var(--icon-box);
		padding: 0;
		border: 0;
		cursor: pointer;
		opacity: 0;
		animation: foil-fade 0.25s linear 0.7s forwards;
	}

	.foot__icon {
		grid-area: 1 / 1;
		display: block;
		width: var(--icon-glyph);
		height: auto;
	}

	/* The glyph reports the state: struck through while the camera is off. */
	.foot__tilt[aria-pressed='false'] .foot__icon--on,
	.foot__tilt[aria-pressed='true'] .foot__icon--off {
		display: none;
	}

	/* Hover drops the knockout, so the glyph goes solid instead of showing the
	   foil through it. */
	.foot__tilt:hover,
	.foot__tilt:focus-visible {
		color: var(--acid);
		mix-blend-mode: normal;
		outline: none;
	}

	@keyframes foil-fade {
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.foot__note,
		.foot__tilt {
			opacity: 1;
		}
	}
</style>

<script>
	import { acid, driftAcid } from '../scripts/acid';

	/* Shader ----------------------------------------------------------- */

	const VERT = `
		attribute vec2 a_pos;
		varying vec2 v_uv;
		void main() {
			v_uv = vec2(a_pos.x, -a_pos.y) * 0.5 + 0.5;
			gl_Position = vec4(a_pos, 0.0, 1.0);
		}
	`;

	const FRAG = `
		precision highp float;

		varying vec2 v_uv;

		uniform vec2 u_res;    // strip size in CSS pixels
		uniform vec2 u_tilt;   // view angle, roughly -1..1 on each axis
		uniform vec3 u_acid;

		const float TAU = 6.28318530718;

		// A diamond across, in CSS pixels rather than in band heights, so the
		// grain stays put instead of stretching with the viewport.
		const float CELL = 19.0;

		// Turns of the spectrum per turn around a cell's centre. It has to be a
		// whole number or the hue tears along the seam at half a turn.
		const float SPECTRUM_TURNS = 1.0;

		// How tight the sheen runs, and how far the colour is allowed from white.
		// Prism foil is a mirror with a rainbow in it, not a rainbow.
		const float SHARPNESS = 3.5;
		const float SATURATION = 0.34;

		// The eye, in CSS pixels: how far in front of the page it sits, and how
		// far it travels for a full tilt. Distance is what sets how much the
		// angle changes from one side of the band to the other, so it is also
		// what sets how many bands of colour are on screen at once.
		const float EYE_DIST = 700.0;
		const float EYE_TRAVEL = 520.0;

		// Spokes of tooling around a cell. Kept low: at any real density they
		// alias into moire long before they read as grooves.
		const float RULING_SPOKES = 14.0;

		// How steeply each cell is embossed, as in-plane slope from its middle to
		// its edge. Parallax alone cannot put a spectrum inside a cell this small:
		// across nineteen pixels at arm's length the angle barely moves. On a real
		// card the sweep comes from the cell being a struck dome rather than a flat
		// patch, so the normal turns across it far faster than the eye does.
		const float EMBOSS = 0.5;

		vec3 spectrum(float t) {
			return 0.5 + 0.5 * cos(TAU * (t + vec3(0.0, 0.33, 0.67)));
		}

		void main() {
			// Everything in CSS pixels, measured from the middle of the band.
			vec2 pos = v_uv * u_res - u_res * 0.5;

			/*
			 * A card is not seen from one angle. Every point on it meets the eye
			 * along a slightly different line, and on a grating a slightly
			 * different line is a different colour. That variation across a single
			 * cell is the gradient, so the eye has to be a position and the view a
			 * per-pixel direction. A single angle for the whole surface makes every
			 * cell one flat colour, which is not what foil does.
			 */
			vec3 eye = vec3(u_tilt * EYE_TRAVEL, EYE_DIST);
			vec3 toEye = normalize(eye - vec3(pos, 0.0));

			// The light stays where it is while the viewer moves. That asymmetry is
			// what keeps the pattern alive as the angle passes through square.
			vec3 toLight = normalize(vec3(-0.28, -0.72, 1.0));

			// A square checkerboard, square to the page.
			vec2 q = v_uv * u_res / CELL;
			vec2 id = floor(q);
			vec2 f = fract(q) - 0.5;
			float checker = mod(id.x + id.y, 2.0);

			/*
			 * Each square is spun rather than ruled straight: the tooling turns
			 * about the cell's middle, so the grooves are spokes and the colour
			 * runs with the angle around that middle, every hue converging on the
			 * one point. Concentric rings cannot do this. They give two opposed
			 * lobes and no convergence, because the angle only ever enters as its
			 * cosine.
			 */
			vec2 fromCentre = f + vec2(1e-5);
			float theta = atan(fromCentre.y, fromCentre.x);

			// The pattern is anchored to the light-to-eye path, so moving your head
			// spins the whole sweep about the centre rather than sliding it.
			vec2 sweep = toEye.xy + toLight.xy;
			float azimuth = atan(sweep.y, sweep.x);

			// Spun one way here and the other way next door, and half a turn of the
			// spectrum apart, so neighbours land on opposite colours. With every
			// cell tooled alike that handedness is what keeps the checkerboard.
			float spin = checker < 0.5 ? 1.0 : -1.0;
			float phase = (theta * spin - azimuth) / TAU * SPECTRUM_TURNS + checker * 0.5;
			vec3 hue = mix(vec3(1.0), spectrum(phase), SATURATION);

			// Spun metal is bright where the grooves lie across the light and dark
			// where they run along it: two lobes, opposite one another, turning
			// with the view.
			float thrown = abs(cos(theta - azimuth));

			// The cell is struck as a shallow dome, bowed the opposite way next
			// door, so the sheen breaks at the seam instead of running through it.
			vec3 normal = normalize(vec3(-fromCentre * EMBOSS * spin, 1.0));
			vec3 mirror = reflect(-toLight, normal);
			float sheen = pow(max(dot(mirror, toEye), 0.0), SHARPNESS);

			// The grooves themselves, as grain. Faded out near the middle, where
			// spokes this fine would only alias.
			float ruling = sin(theta * RULING_SPOKES);
			float glint = smoothstep(0.55, 1.0, ruling)
				* smoothstep(0.0, 0.22, length(fromCentre)) * 0.03;

			// Foil is scored between the cells, so the seams catch first. Faint:
			// any stronger and the grid reads as drawn rather than as tooling.
			glint += smoothstep(0.44, 0.5, max(abs(f.x), abs(f.y))) * 0.07;

			// A touch of the page colour so the band belongs to it, but only a
			// touch: this finish is closer to a CD than to a prism.
			vec3 tint = mix(u_acid, vec3(1.0), 0.18);
			vec3 foil = hue * (0.58 + 0.3 * thrown + 0.28 * sheen);
			foil = mix(foil, foil * tint * 1.55, 0.1);
			foil += glint * (0.45 + 0.55 * hue);

			gl_FragColor = vec4(clamp(foil, 0.0, 1.0), 1.0);
		}
	`;

	function compile(gl: WebGLRenderingContext, type: number, src: string) {
		const shader = gl.createShader(type);
		if (!shader) return null;
		gl.shaderSource(shader, src);
		gl.compileShader(shader);
		if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
			console.warn(gl.getShaderInfoLog(shader));
			gl.deleteShader(shader);
			return null;
		}
		return shader;
	}

	/* Head tracking ---------------------------------------------------- */

	/*
	 * Where the viewer's head is, as an offset from centre. Nothing leaves the
	 * page: frames go to a 64x48 scratch canvas and nowhere else, and the camera
	 * is only ever touched after a click.
	 *
	 * FaceDetector does the job properly where it exists, which today is
	 * essentially Chrome with the flag on. The fallback is a skin-tone centroid,
	 * which is crude and hates bad light, but it tracks a head well enough to
	 * drive a reflection and costs nothing to ship.
	 */
	type Head = { x: number; y: number; found: boolean };

	// A front camera hands over an unmirrored frame, so leaning right moves the
	// head left in it. Flip so the reflection follows the way you actually lean.
	const FLIP_X = -1;

	function createTracker() {
		const video = document.createElement('video');
		video.muted = true;
		video.playsInline = true;

		const scratch = document.createElement('canvas');
		scratch.width = 64;
		scratch.height = 48;
		const ctx = scratch.getContext('2d', { willReadFrequently: true });

		const Detector = (window as unknown as { FaceDetector?: new (o: object) => object })
			.FaceDetector;
		const detector = Detector ? new Detector({ fastMode: true, maxDetectedFaces: 1 }) : null;
		let stream: MediaStream | null = null;

		const read = async (): Promise<Head> => {
			if (!ctx || video.readyState < 2) return { x: 0, y: 0, found: false };

			if (detector) {
				const faces = await (
					detector as { detect: (v: HTMLVideoElement) => Promise<{ boundingBox: DOMRectReadOnly }[]> }
				).detect(video);
				const box = faces[0]?.boundingBox;
				if (box) {
					return {
						x: (box.x + box.width / 2) / video.videoWidth - 0.5,
						y: (box.y + box.height / 2) / video.videoHeight - 0.5,
						found: true,
					};
				}
				return { x: 0, y: 0, found: false };
			}

			ctx.drawImage(video, 0, 0, scratch.width, scratch.height);
			const { data } = ctx.getImageData(0, 0, scratch.width, scratch.height);
			let sx = 0;
			let sy = 0;
			let weight = 0;
			for (let i = 0, px = 0; i < data.length; i += 4, px++) {
				const r = data[i];
				const g = data[i + 1];
				const b = data[i + 2];
				const max = Math.max(r, g, b);
				const min = Math.min(r, g, b);
				// The usual skin-tone box: warm, not grey, red ahead of the rest.
				const skin = r > 80 && g > 30 && b > 15 && max - min > 12 && r - g > 12 && r > b;
				if (!skin) continue;
				sx += px % scratch.width;
				sy += (px / scratch.width) | 0;
				weight++;
			}
			// Too few pixels is noise, not a face.
			if (weight < 25) return { x: 0, y: 0, found: false };
			return {
				x: sx / weight / scratch.width - 0.5,
				y: sy / weight / scratch.height - 0.5,
				found: true,
			};
		};

		const start = async () => {
			stream = await navigator.mediaDevices.getUserMedia({
				video: { width: 320, height: 240, facingMode: 'user' },
			});
			video.srcObject = stream;
			await video.play();
		};

		const stop = () => {
			stream?.getTracks().forEach((track) => track.stop());
			stream = null;
			video.srcObject = null;
		};

		return { start, stop, read };
	}

	/* Strip ------------------------------------------------------------ */

	function renderStrip() {
		const strip = document.querySelector<HTMLElement>('.foot');
		const canvas = strip?.querySelector<HTMLCanvasElement>('.foil__gl');
		if (!strip || !canvas) return;

		const gl = canvas.getContext('webgl', {
			alpha: false,
			antialias: false,
			depth: false,
			stencil: false,
		});
		if (!gl) return;

		const vs = compile(gl, gl.VERTEX_SHADER, VERT);
		const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
		const program = gl.createProgram();
		if (!vs || !fs || !program) return;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
			console.warn(gl.getProgramInfoLog(program));
			return;
		}
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const loc = gl.getAttribLocation(program, 'a_pos');
		gl.enableVertexAttribArray(loc);
		gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

		const u = {
			res: gl.getUniformLocation(program, 'u_res'),
			tilt: gl.getUniformLocation(program, 'u_tilt'),
			acid: gl.getUniformLocation(program, 'u_acid'),
		};

		const resize = () => {
			const rect = strip.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const w = Math.max(1, Math.round(rect.width * dpr));
			const h = Math.max(1, Math.round(rect.height * dpr));
			if (canvas.width === w && canvas.height === h) return;

			canvas.width = w;
			canvas.height = h;
			gl.viewport(0, 0, w, h);
			// CSS pixels, not device pixels: the cell size is a design measure and
			// should not halve on a retina screen.
			gl.uniform2f(u.res, rect.width, rect.height);
		};

		resize();
		new ResizeObserver(resize).observe(strip);

		const idle = { x: 0, y: 0 };
		const pointer = { x: 0, y: 0 };
		const head = { x: 0, y: 0, live: false };

		// A spring again: head tracking especially is far too jittery to use raw.
		const STIFFNESS = 18;
		const DAMPING = 2 * Math.sqrt(18) * 0.85;
		const tilt = { x: 0, y: 0 };
		const vel = { x: 0, y: 0 };

		window.addEventListener(
			'pointermove',
			(e) => {
				pointer.x = (e.clientX / window.innerWidth) * 2 - 1;
				pointer.y = (e.clientY / window.innerHeight) * 2 - 1;
			},
			{ passive: true }
		);

		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const started = performance.now();
		let last = started;

		const frame = (now: number) => {
			const dt = Math.min((now - last) / 1000, 0.05);
			last = now;
			const t = (now - started) / 1000;

			// Two detuned sines per axis: a wander rather than a loop.
			idle.x = Math.sin(t * 0.29) * 0.5 + Math.sin(t * 0.11 + 1.7) * 0.22;
			idle.y = Math.cos(t * 0.19) * 0.34 + Math.sin(t * 0.07 + 0.6) * 0.16;

			const want = head.live
				? { x: head.x, y: head.y }
				: { x: idle.x + pointer.x * 0.45, y: idle.y + pointer.y * 0.3 };

			vel.x += (-STIFFNESS * (tilt.x - want.x) - DAMPING * vel.x) * dt;
			vel.y += (-STIFFNESS * (tilt.y - want.y) - DAMPING * vel.y) * dt;
			tilt.x += vel.x * dt;
			tilt.y += vel.y * dt;

			gl.uniform2f(u.tilt, tilt.x, tilt.y);
			// The strip sits flush against the page, so it tracks the drifting
			// background rather than a colour sampled once at startup.
			gl.uniform3fv(u.acid, acid());
			gl.drawArrays(gl.TRIANGLES, 0, 3);

			if (!still || head.live) requestAnimationFrame(frame);
		};

		requestAnimationFrame(frame);

		/* Camera opt-in --------------------------------------------------- */

		const button = document.querySelector<HTMLButtonElement>('[data-tilt]');
		let tracker: ReturnType<typeof createTracker> | null = null;

		// The control is a glyph, so its state has to live in the label rather
		// than in what it says.
		const label = (text: string) => {
			button?.setAttribute('aria-label', text);
			button?.setAttribute('title', text);
		};

		button?.addEventListener('click', async () => {
			if (head.live) {
				tracker?.stop();
				tracker = null;
				head.live = false;
				head.x = 0;
				head.y = 0;
				button.setAttribute('aria-pressed', 'false');
				label('Tilt with camera');
				return;
			}

			label('Asking for the camera');
			tracker = createTracker();
			try {
				await tracker.start();
			} catch (err) {
				tracker = null;
				label(`Camera ${(err as Error).name === 'NotAllowedError' ? 'refused' : 'failed'}`);
				return;
			}

			head.live = true;
			button.setAttribute('aria-pressed', 'true');
			label('Tilting with camera');
			if (still) requestAnimationFrame(frame);

			// Reading every frame is wasted work: a head does not move that fast,
			// and the spring is what makes it look continuous anyway.
			let misses = 0;
			const poll = async () => {
				if (!head.live || !tracker) return;
				const found = await tracker.read();
				if (found.found) {
					misses = 0;
					// Scaled up because a head crosses only a fraction of the frame.
					head.x = Math.max(-1, Math.min(1, found.x * 2.6 * FLIP_X));
					head.y = Math.max(-1, Math.min(1, found.y * 2.6));
					label('Tilting with camera');
				} else if (++misses === 8) {
					label('No head found');
				}
				setTimeout(poll, 90);
			};
			poll();
		});
	}

	driftAcid();
	renderStrip();
</script>
