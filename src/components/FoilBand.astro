---
/*
 * A strip of holofoil across the foot of the page. The finishes are the ones
 * collectors name: cosmos, cracked ice, sequin, and so on. Each is a different
 * micro-structure catching the light, so the shader models them the same way a
 * real one works: a field of facets, a view angle, and a spectrum that shifts
 * as the angle changes. Nothing animates on its own. All of the movement comes
 * from the angle, which is the whole point of foil.
 *
 * TEMPORARY: the selector is a scratch control for picking a finish. Every
 * piece of it is marked `SELECTOR` so it can be lifted out in one pass.
 */

interface Props {
	note: string;
}

const { note } = Astro.props;

const patterns = [
	{ id: 'diamond', label: 'Diamond checker' },
	{ id: 'cosmos', label: 'Cosmos' },
	{ id: 'ice', label: 'Cracked ice' },
	{ id: 'sequin', label: 'Sequin' },
	{ id: 'tinsel', label: 'Tinsel' },
	{ id: 'mirror', label: 'Mirror' },
	{ id: 'reverse', label: 'Reverse' },
	{ id: 'etched', label: 'Etched' },
	{ id: 'refractor', label: 'Refractor' },
	{ id: 'prizm', label: 'Prizm' },
];
---

<footer class="foot">
	<div class="foot__strip"><canvas class="foil__gl" aria-hidden="true"></canvas></div>
	<span class="foot__note" data-scramble="540">{note}</span>
</footer>

{/* SELECTOR ---------------------------------------------------------- */}
<aside class="picker" aria-label="Foil finish (temporary)">
	<div class="picker__row picker__row--wrap">
		{
			patterns.map((pattern, i) => (
				<button class="picker__chip" type="button" data-pattern={i}>
					{pattern.label}
				</button>
			))
		}
	</div>

	<label class="picker__row">
		<span class="picker__key">Strength</span>
		<input class="picker__slider" type="range" min="0" max="100" value="80" data-strength />
	</label>

	<div class="picker__row">
		<button class="picker__chip" type="button" data-camera>Head tracking</button>
		<label class="picker__flip"><input type="checkbox" data-flip checked /> Flip X</label>
	</div>

	<p class="picker__status" data-status role="status">Pointer and drift</p>
</aside>

<style>
	.foot {
		position: fixed;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		font-size: clamp(0.6rem, 1.5vw, 0.7rem);
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	/* A rule, not a panel. The foil reads as an edge caught in the light. */
	.foot__strip {
		position: relative;
		height: clamp(0.5rem, 1.5svh, 0.85rem);
	}

	.foil__gl {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	.foot__note {
		padding: clamp(0.7rem, 2svh, 1.1rem) clamp(0.9rem, 2.4vw, 1.6rem);
		opacity: 0;
		animation: foil-fade 0.25s linear 0.64s forwards;
	}

	@keyframes foil-fade {
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.foot__note {
			opacity: 1;
		}
	}

	/* SELECTOR ---------------------------------------------------------- */

	.picker {
		position: fixed;
		right: clamp(0.9rem, 2.4vw, 1.6rem);
		bottom: calc(clamp(0.5rem, 1.5svh, 0.85rem) + 3.4rem);
		z-index: 5;
		width: min(21rem, calc(100vw - 2rem));
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.6rem;
		border: 1px solid var(--ink);
		background: var(--acid);
		font-size: 0.6rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.picker__row {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.picker__row--wrap {
		flex-wrap: wrap;
	}

	.picker__chip {
		padding: 0.25rem 0.4rem;
		border: 1px solid var(--ink);
		background: transparent;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		cursor: pointer;
	}

	.picker__chip[aria-pressed='true'] {
		background: var(--ink);
		color: var(--acid);
	}

	.picker__key {
		flex: none;
	}

	.picker__slider {
		flex: 1;
		accent-color: var(--ink);
	}

	.picker__flip {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		cursor: pointer;
	}

	.picker__status {
		margin: 0;
		opacity: 0.65;
		text-transform: none;
		letter-spacing: 0.04em;
	}
</style>

<script>
	import { acid, driftAcid } from '../scripts/acid';

	/* Shader ----------------------------------------------------------- */

	const VERT = `
		attribute vec2 a_pos;
		varying vec2 v_uv;
		void main() {
			v_uv = vec2(a_pos.x, -a_pos.y) * 0.5 + 0.5;
			gl_Position = vec4(a_pos, 0.0, 1.0);
		}
	`;

	/*
	 * Every finish resolves to the same four values, and the composite at the
	 * bottom is shared. What separates cracked ice from sequin is only the shape
	 * of the facet field feeding it.
	 *
	 *   n      facet slope. The spectrum is indexed by how it meets the view.
	 *   micro  how much of the surface the structure actually covers.
	 *   glint  discrete highlights, for finishes made of separate flakes.
	 *   sharp  how tight the specular is. Higher reads harder and more mirror.
	 */
	const FRAG = `
		precision highp float;

		varying vec2 v_uv;

		uniform vec2  u_res;
		uniform vec2  u_tilt;      // view angle, roughly -1..1 on each axis
		uniform float u_pattern;
		uniform float u_strength;
		uniform vec4  u_window;    // reverse holo knockout, in uv
		uniform vec3  u_acid;

		const float TAU = 6.28318530718;

		float hash21(vec2 p) {
			return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
		}

		vec2 hash22(vec2 p) {
			return fract(sin(vec2(
				dot(p, vec2(127.1, 311.7)),
				dot(p, vec2(269.5, 183.3))
			)) * 43758.5453123);
		}

		float vnoise(vec2 p) {
			vec2 i = floor(p);
			vec2 f = fract(p);
			f = f * f * (3.0 - 2.0 * f);
			return mix(
				mix(hash21(i), hash21(i + vec2(1.0, 0.0)), f.x),
				mix(hash21(i + vec2(0.0, 1.0)), hash21(i + vec2(1.0, 1.0)), f.x),
				f.y
			);
		}

		// Slope of the noise field, which is what a facet normal amounts to here.
		vec2 nslope(vec2 p, float e) {
			return vec2(
				vnoise(p + vec2(e, 0.0)) - vnoise(p - vec2(e, 0.0)),
				vnoise(p + vec2(0.0, e)) - vnoise(p - vec2(0.0, e))
			) / (2.0 * e);
		}

		// Cheap smooth rainbow that wraps cleanly.
		vec3 spectrum(float t) {
			return 0.5 + 0.5 * cos(TAU * (t + vec3(0.0, 0.33, 0.67)));
		}

		// x: cell id, y: distance to the nearest edge, zw: offset to the centre.
		vec4 cells(vec2 p) {
			vec2 base = floor(p);
			vec2 f = p - base;
			float best = 8.0;
			float second = 8.0;
			float id = 0.0;
			vec2 off = vec2(0.0);
			for (int j = -1; j <= 1; j++) {
				for (int i = -1; i <= 1; i++) {
					vec2 g = vec2(float(i), float(j));
					vec2 r = g + hash22(base + g) - f;
					float d = dot(r, r);
					if (d < best) {
						second = best;
						best = d;
						id = hash21(base + g);
						off = r;
					} else if (d < second) {
						second = d;
					}
				}
			}
			return vec4(id, sqrt(second) - sqrt(best), off);
		}

		void main() {
			float aspect = u_res.x / max(u_res.y, 1.0);
			// Pattern scale is in units of band height, so the structure keeps its
			// size when the band gets wider.
			vec2 st = vec2(v_uv.x * aspect, v_uv.y);

			// The light is fixed and the viewer moves, which is the whole trick.
			// Without a light offset the response is symmetric about head-on, so
			// facets cut in opposite directions read identical every time the
			// angle passes through square and the pattern vanishes.
			vec2 view = u_tilt + vec2(0.32, -0.58);

			vec2  n = vec2(0.0);
			float micro = 1.0;
			float glint = 0.0;
			float sharp = 6.0;
			float disp = 1.6;
			// How far the spectrum is allowed from white. Prism foil is a mirror
			// with a rainbow in it, not a rainbow.
			float sat = 1.0;

			float pat = u_pattern;

			if (pat < 0.5) {
				// Diamond checker, the vintage Carddass prism. It is one foil
				// throughout, not a set of facets tilted against each other: every
				// cell holds the same ruled grating and only its orientation turns
				// from cell to cell. Because a grating throws its spectrum across
				// the rulings, two cells at ninety degrees answer the same viewing
				// angle with different colours, and turning the card walks each set
				// through the spectrum at its own rate. That is the whole pattern.
				//
				// Sized in CSS pixels rather than band heights: the strip is a rule
				// now, and grain this fine should not shrink with it.
				vec2 q = v_uv * u_res / 19.0;
				vec2 lat = vec2(q.x + q.y, q.x - q.y) * 0.7071;
				vec2 id = floor(lat);
				vec2 f = fract(lat) - 0.5;
				float checker = mod(id.x + id.y, 2.0);

				// The two rulings, square to each other.
				vec2 dir = checker < 0.5 ? vec2(0.94, 0.34) : vec2(0.34, -0.94);
				n = dir * 1.7;

				// The rulings themselves, as grain rather than as structure.
				vec2 across = vec2(-dir.y, dir.x);
				float ruling = sin(dot(v_uv * u_res, across) * 1.15);
				glint = smoothstep(0.55, 1.0, ruling) * 0.22;

				// Foil is scored between the cells, so the seams catch first.
				glint += smoothstep(0.44, 0.5, max(abs(f.x), abs(f.y))) * 0.28;

				// Neutral: silver first, spectrum second. This is a CD, not a prism.
				sat = 0.42;
				sharp = 3.2;
				disp = 2.4;
			} else if (pat < 1.5) {
				// Cosmos. A broad nebula slope carrying a dense field of flakes,
				// each of which only lights up when the view lines up with the
				// angle it happens to sit at. That is the twinkle.
				n = nslope(st * 2.4, 0.02) * 0.5;

				vec2 g = st * 40.0;
				vec2 id = floor(g);
				vec2 f = fract(g) - 0.5;
				vec2 jitter = hash22(id) - 0.5;
				float d = length(f - jitter * 0.8);
				float flake = smoothstep(0.34, 0.02, d);
				vec2 own = (hash22(id + 5.1) - 0.5) * 2.2;
				float align = exp(-dot(view - own, view - own) * 5.0);
				glint = flake * align * 1.5;
				micro = 0.85;
				disp = 2.2;
			} else if (pat < 2.5) {
				// Cracked ice. Shards with flat interiors, so the colour holds
				// across a whole piece and snaps at the fracture lines.
				vec4 c = cells(st * 7.0);
				n = (hash22(vec2(c.x, c.x + 1.0)) - 0.5) * 2.4;
				float seam = smoothstep(0.06, 0.0, c.y);
				glint = seam * 0.8;
				sharp = 3.0;
				disp = 1.3;
			} else if (pat < 3.5) {
				// Sequin. Discs on a staggered grid, each domed, so every one runs
				// the full spectrum from its own edge to its centre.
				vec2 g = st * 13.0;
				float row = floor(g.y);
				g.x += mod(row, 2.0) * 0.5;
				vec2 f = fract(g) - 0.5;
				float r = length(f) / 0.42;
				float disc = smoothstep(1.0, 0.9, r);
				n = f / 0.42 * 1.7;
				micro = disc;
				glint = disc * smoothstep(0.55, 0.0, length(f / 0.42 - view * 0.55)) * 0.9;
				sharp = 5.0;
				disp = 1.8;
			} else if (pat < 4.5) {
				// Tinsel. Fine vertical strands: all of the play is horizontal,
				// which is why tinsel cards look dead when you tilt them the wrong
				// way and come alive across.
				float strands = st.x * 190.0;
				n = vec2(sin(strands) * 1.9, 0.06);
				micro = 0.95;
				sharp = 9.0;
				disp = 2.6;
			} else if (pat < 5.5) {
				// Mirror. No micro-structure at all, one broad sweep. The plainest
				// finish and the one that shows the tilt most honestly.
				n = (v_uv - 0.5) * vec2(1.4, 2.2);
				sharp = 2.2;
				disp = 1.0;
			} else if (pat < 6.5) {
				// Reverse holo. Foil across everything except the art window, which
				// here is the type. Knocked out with a soft edge so it reads as a
				// masked print rather than a hole.
				n = nslope(st * 2.0, 0.02) * 0.45;

				vec2 g = st * 34.0;
				vec2 id = floor(g);
				vec2 f = fract(g) - 0.5;
				float d = length(f - (hash22(id) - 0.5) * 0.7);
				glint = smoothstep(0.3, 0.02, d) * 0.5;

				vec2 inside = smoothstep(u_window.xy - 0.02, u_window.xy + 0.02, v_uv)
					* (1.0 - smoothstep(u_window.zw - 0.02, u_window.zw + 0.02, v_uv));
				micro = 1.0 - inside.x * inside.y;
				disp = 2.0;
			} else if (pat < 7.5) {
				// Etched. Raised ridges you would feel with a thumb, so this one
				// leans on the specular and keeps the rainbow down.
				float ridge = sin(st.x * 26.0 + sin(st.y * 9.0) * 2.0);
				float bevel = cos(st.x * 26.0 + sin(st.y * 9.0) * 2.0);
				n = vec2(bevel * 1.4, sign(ridge) * 0.35);
				glint = pow(clamp(1.0 - abs(ridge - view.x * 0.6), 0.0, 1.0), 14.0) * 1.1;
				sharp = 12.0;
				disp = 0.55;
			} else if (pat < 8.5) {
				// Refractor. A diffraction grating: fine diagonal rulings that
				// split the spectrum hard and sweep it fast.
				float grating = dot(st, normalize(vec2(0.55, 1.0))) * 150.0;
				n = vec2(sin(grating) * 1.2, cos(grating) * 1.2);
				micro = 1.0;
				sharp = 7.0;
				disp = 3.4;
			} else {
				// Prizm. Big triangular facets, each a flat plane, so the band
				// breaks into slabs of colour that flip over as a group.
				vec2 g = st * 5.5;
				vec2 id = floor(g);
				vec2 f = fract(g);
				float upper = step(1.0, f.x + f.y);
				vec2 seed = id + upper * 31.7;
				n = (hash22(seed) - 0.5) * 2.6;
				float edge = abs(f.x + f.y - 1.0);
				glint = smoothstep(0.05, 0.0, edge) * 0.5;
				sharp = 3.5;
				disp = 1.2;
			}

			// Shared response. The spectrum is indexed by how the facet meets the
			// view, and the specular peaks where the facet points straight at it.
			vec3 hue = spectrum(dot(n, view) * disp + 0.5);
			float spec = pow(clamp(1.0 - 0.75 * length(n - view), 0.0, 1.0), sharp);

			// The spectrum leads and the specular rides on top. Mixing the two
			// halfway, which is the obvious way to write this, greys out every
			// facet that is not directly catching the light, and grey is the one
			// thing foil never looks like.
			vec3 tint = mix(u_acid, vec3(1.0), 0.18);
			vec3 foil = hue * (0.62 + 0.8 * spec);
			foil = mix(foil, foil * tint * 1.55, 0.3);
			foil += glint * (0.45 + 0.55 * hue);

			vec3 col = mix(u_acid, foil, clamp(u_strength * micro, 0.0, 1.0));
			gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
		}
	`;

	function compile(gl: WebGLRenderingContext, type: number, src: string) {
		const shader = gl.createShader(type);
		if (!shader) return null;
		gl.shaderSource(shader, src);
		gl.compileShader(shader);
		if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
			console.warn(gl.getShaderInfoLog(shader));
			gl.deleteShader(shader);
			return null;
		}
		return shader;
	}

	/* Head tracking ---------------------------------------------------- */

	/*
	 * Where the viewer's head is, as an offset from centre. Everything stays in
	 * the page: the frames go to a 64x48 scratch canvas and nowhere else.
	 *
	 * FaceDetector does the job properly where it exists, which today is
	 * essentially Chrome with the flag on. The fallback is a skin-tone centroid,
	 * which is crude and hates bad light, but it tracks a head well enough to
	 * drive a reflection and costs nothing to ship.
	 */
	type Head = { x: number; y: number; found: boolean };

	function createTracker() {
		const video = document.createElement('video');
		video.muted = true;
		video.playsInline = true;

		const scratch = document.createElement('canvas');
		scratch.width = 64;
		scratch.height = 48;
		const ctx = scratch.getContext('2d', { willReadFrequently: true });

		const Detector = (window as unknown as { FaceDetector?: new (o: object) => object })
			.FaceDetector;
		const detector = Detector ? new Detector({ fastMode: true, maxDetectedFaces: 1 }) : null;
		let stream: MediaStream | null = null;

		const read = async (): Promise<Head> => {
			if (!ctx || video.readyState < 2) return { x: 0, y: 0, found: false };

			if (detector) {
				const faces = await (
					detector as { detect: (v: HTMLVideoElement) => Promise<{ boundingBox: DOMRectReadOnly }[]> }
				).detect(video);
				const box = faces[0]?.boundingBox;
				if (box) {
					return {
						x: (box.x + box.width / 2) / video.videoWidth - 0.5,
						y: (box.y + box.height / 2) / video.videoHeight - 0.5,
						found: true,
					};
				}
				return { x: 0, y: 0, found: false };
			}

			ctx.drawImage(video, 0, 0, scratch.width, scratch.height);
			const { data } = ctx.getImageData(0, 0, scratch.width, scratch.height);
			let sx = 0;
			let sy = 0;
			let weight = 0;
			for (let i = 0, px = 0; i < data.length; i += 4, px++) {
				const r = data[i];
				const g = data[i + 1];
				const b = data[i + 2];
				const max = Math.max(r, g, b);
				const min = Math.min(r, g, b);
				// The usual skin-tone box: warm, not grey, red ahead of the rest.
				const skin =
					r > 80 && g > 30 && b > 15 && max - min > 12 && r - g > 12 && r > b;
				if (!skin) continue;
				sx += px % scratch.width;
				sy += (px / scratch.width) | 0;
				weight++;
			}
			// Too few pixels is noise, not a face.
			if (weight < 25) return { x: 0, y: 0, found: false };
			return {
				x: sx / weight / scratch.width - 0.5,
				y: sy / weight / scratch.height - 0.5,
				found: true,
			};
		};

		const start = async () => {
			stream = await navigator.mediaDevices.getUserMedia({
				video: { width: 320, height: 240, facingMode: 'user' },
			});
			video.srcObject = stream;
			await video.play();
			return detector ? 'FaceDetector' : 'skin-tone centroid';
		};

		const stop = () => {
			stream?.getTracks().forEach((track) => track.stop());
			stream = null;
			video.srcObject = null;
		};

		return { start, stop, read };
	}

	/* Band ------------------------------------------------------------- */

	function renderBand() {
		const band = document.querySelector<HTMLElement>('.foil');
		const canvas = band?.querySelector<HTMLCanvasElement>('.foil__gl');
		const note = band?.querySelector<HTMLElement>('.foil__note');
		if (!band || !canvas || !note) return;

		const gl = canvas.getContext('webgl', {
			alpha: false,
			antialias: false,
			depth: false,
			stencil: false,
		});
		if (!gl) return;

		const vs = compile(gl, gl.VERTEX_SHADER, VERT);
		const fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
		const program = gl.createProgram();
		if (!vs || !fs || !program) return;
		gl.attachShader(program, vs);
		gl.attachShader(program, fs);
		gl.linkProgram(program);
		if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
			console.warn(gl.getProgramInfoLog(program));
			return;
		}
		gl.useProgram(program);

		const buffer = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const loc = gl.getAttribLocation(program, 'a_pos');
		gl.enableVertexAttribArray(loc);
		gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

		const u = {
			res: gl.getUniformLocation(program, 'u_res'),
			tilt: gl.getUniformLocation(program, 'u_tilt'),
			pattern: gl.getUniformLocation(program, 'u_pattern'),
			strength: gl.getUniformLocation(program, 'u_strength'),
			window: gl.getUniformLocation(program, 'u_window'),
			acid: gl.getUniformLocation(program, 'u_acid'),
		};

		const state = { pattern: 0, strength: 0.8, flip: true };

		const resize = () => {
			const rect = band.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			const w = Math.max(1, Math.round(rect.width * dpr));
			const h = Math.max(1, Math.round(rect.height * dpr));
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w;
				canvas.height = h;
				gl.viewport(0, 0, w, h);
				gl.uniform2f(u.res, w, h);
			}

			// Where the type sits, for the reverse holo knockout.
			const box = note.getBoundingClientRect();
			gl.uniform4f(
				u.window,
				(box.left - rect.left) / rect.width - 0.02,
				(box.top - rect.top) / rect.height - 0.12,
				(box.right - rect.left) / rect.width + 0.02,
				(box.bottom - rect.top) / rect.height + 0.12
			);
		};

		resize();
		new ResizeObserver(resize).observe(band);

		/*
		 * View angle. Off camera it is a slow drift with the pointer layered on
		 * top, which is the closest a mouse gets to turning a card in your hand.
		 * On camera it is where the viewer's head actually is.
		 */
		const idle = { x: 0, y: 0 };
		const pointer = { x: 0, y: 0 };
		const head = { x: 0, y: 0, live: false };

		// Springs again: head tracking especially is far too jittery to use raw.
		const STIFFNESS = 18;
		const DAMPING = 2 * Math.sqrt(18) * 0.85;
		const tilt = { x: 0, y: 0 };
		const vel = { x: 0, y: 0 };

		window.addEventListener(
			'pointermove',
			(e) => {
				pointer.x = (e.clientX / window.innerWidth) * 2 - 1;
				pointer.y = (e.clientY / window.innerHeight) * 2 - 1;
			},
			{ passive: true }
		);

		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const started = performance.now();
		let last = started;

		const frame = (now: number) => {
			const dt = Math.min((now - last) / 1000, 0.05);
			last = now;
			const t = (now - started) / 1000;

			// Two detuned sines per axis: a wander rather than a loop.
			idle.x = Math.sin(t * 0.29) * 0.5 + Math.sin(t * 0.11 + 1.7) * 0.22;
			idle.y = Math.cos(t * 0.19) * 0.34 + Math.sin(t * 0.07 + 0.6) * 0.16;

			const want = head.live
				? { x: head.x, y: head.y }
				: { x: idle.x + pointer.x * 0.45, y: idle.y + pointer.y * 0.3 };

			vel.x += (-STIFFNESS * (tilt.x - want.x) - DAMPING * vel.x) * dt;
			vel.y += (-STIFFNESS * (tilt.y - want.y) - DAMPING * vel.y) * dt;
			tilt.x += vel.x * dt;
			tilt.y += vel.y * dt;

			gl.uniform2f(u.tilt, tilt.x, tilt.y);
			gl.uniform1f(u.pattern, state.pattern);
			gl.uniform1f(u.strength, state.strength);
			// The band sits flush against the page, so it tracks the drifting
			// background rather than a colour sampled once at startup.
			gl.uniform3fv(u.acid, acid());
			gl.drawArrays(gl.TRIANGLES, 0, 3);

			if (!still || head.live) requestAnimationFrame(frame);
		};

		requestAnimationFrame(frame);

		/* SELECTOR ------------------------------------------------------ */

		const picker = document.querySelector<HTMLElement>('.picker');
		const status = picker?.querySelector<HTMLElement>('[data-status]');
		const chips = picker?.querySelectorAll<HTMLButtonElement>('[data-pattern]');
		const say = (text: string) => {
			if (status) status.textContent = text;
		};

		chips?.forEach((chip) => {
			chip.setAttribute('aria-pressed', String(Number(chip.dataset.pattern) === 0));
			chip.addEventListener('click', () => {
				state.pattern = Number(chip.dataset.pattern);
				chips.forEach((other) => other.setAttribute('aria-pressed', String(other === chip)));
				if (still && !head.live) requestAnimationFrame(frame);
			});
		});

		picker?.querySelector<HTMLInputElement>('[data-strength]')?.addEventListener('input', (e) => {
			state.strength = Number((e.target as HTMLInputElement).value) / 100;
			if (still && !head.live) requestAnimationFrame(frame);
		});

		const flip = picker?.querySelector<HTMLInputElement>('[data-flip]');
		flip?.addEventListener('change', () => {
			state.flip = flip.checked;
		});

		const camera = picker?.querySelector<HTMLButtonElement>('[data-camera]');
		let tracker: ReturnType<typeof createTracker> | null = null;

		camera?.addEventListener('click', async () => {
			if (head.live) {
				tracker?.stop();
				tracker = null;
				head.live = false;
				camera.setAttribute('aria-pressed', 'false');
				say('Pointer and drift');
				return;
			}

			say('Asking for the camera…');
			tracker = createTracker();
			let how: string;
			try {
				how = await tracker.start();
			} catch (err) {
				tracker = null;
				say(`Camera refused: ${(err as Error).name}`);
				return;
			}

			head.live = true;
			camera.setAttribute('aria-pressed', 'true');
			say(`Tracking via ${how}`);
			if (still) requestAnimationFrame(frame);

			// Reading every frame is wasted work: a head does not move that fast,
			// and the spring is what makes it look continuous anyway.
			let misses = 0;
			const poll = async () => {
				if (!head.live || !tracker) return;
				const found = await tracker.read();
				if (found.found) {
					misses = 0;
					// Doubled because a head crosses only a fraction of the frame.
					const sign = state.flip ? -1 : 1;
					head.x = Math.max(-1, Math.min(1, found.x * 2.6 * sign));
					head.y = Math.max(-1, Math.min(1, found.y * 2.6));
					say(`Tracking via ${how}`);
				} else if (++misses === 8) {
					say(`No head found. ${how}, so try more light.`);
				}
				setTimeout(poll, 90);
			};
			poll();
		});
	}

	driftAcid();
	renderBand();
</script>
