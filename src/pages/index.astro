---
import "@fontsource-variable/inter";
import "@fontsource-variable/rubik";

import HeadNav from "../components/HeadNav.astro";
import ScrollNav from "../components/ScrollNav.astro";

import Punch from "../components/sections/Punch.astro";
import Montezuma from "../components/sections/Montezuma.astro";
import Swordfish from "../components/sections/Swordfish.astro";
import Splash from "../components/sections/Splash.astro";
import About from "../components/sections/About.astro";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <!-- <meta name="description" content="Astro description" /> -->
        <!-- <meta name="viewport" content="width=device-width" /> -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <script
            src="https://kit.fontawesome.com/3fd0af1c48.js"
            crossorigin="anonymous"></script>
        <title>Playsthetic</title>
    </head>
    <body>
        <HeadNav />
        <div class="holder">
            <Splash />
            <!-- <Montezuma />
            <Punch />
            <Swordfish /> -->
            <!-- <About /> -->
        </div>
        <!-- <ScrollNav /> -->
    </body>
</html>

<style lang="scss" is:global>
    $text-color: rgb(63, 63, 63);
    $background-color: rgb(218, 214, 214);

    body {
        font-family: "Rubik Variable";
        font-size: 14px;
        color: $text-color;
        background-color: $background-color;
        /* background: radial-gradient(circle at center, rgb(48, 48, 48), #171717); */
    }

    .holder {
        scroll-snap-type: y mandatory;
        overflow-y: scroll;
        height: 100vh;
    }
    .section {
        position: relative;
        height: 100vh;
        scroll-snap-align: start;
    }
    .content {
        position: relative;
        padding-top: 0px;
        padding-left: 300px;
        padding-right: 300px;
        height: 100vh;
    }

    .fab {
        font-size: 60px;
        padding: 20px;
    }

    .fa-solid,
    .fa-brands {
        color: #2cd48c;
        font-size: 50px;
        padding-bottom: 15px;
        padding-left: 5px;
    }

    .deck {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: minmax(100px, auto);
        flex-wrap: wrap;
        justify-content: space-between;
    }

    .card {
        flex: 1;
        margin: 10px;
        background: lighten($background-color, 2%);
        border-radius: 5px;
        padding: 20px;
        // box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
    }

    hr {
        border: 0;
        height: 2px;
        background: rgb(63, 63, 63);
        margin: 0px 0px 20px 0px;
    }
    h1 {
        font-size: 50px;
        font-weight: bold;
    }

    h2 {
        font-size: 22px;
        padding-bottom: 15px;
        // font-weight: bold;
        text-transform: uppercase;
    }

    h3 {
        font-size: 20px;
        padding-bottom: 20px;
        font-weight: bold;
        text-transform: uppercase;
    }

    h4 {
        text-transform: uppercase;
        margin-bottom: 10px;
        font-size: 14px;
        font-weight: bold;
    }

    a {
        color: inherit; /* Inherit the color from the parent element */
        text-decoration: none; /* Remove the underline */
    }

    .bg-color {
        background-colorlor: $background-color;
    }

    .text-color {
        color: $text-color;
    }
</style>
